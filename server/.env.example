# Master/control-plane DB — holds Tenants, platform Users, billing
MASTER_MONGODB_URI=mongodb://127.0.0.1:27017/saas_master

# Base URI used to derive each tenant's own database.
# Tenant DB name = TENANT_DB_PREFIX + tenant.dbName
# e.g. mongodb://127.0.0.1:27017/  ->  mongodb://127.0.0.1:27017/tenant_mayaa
TENANT_MONGODB_BASE_URI=mongodb://127.0.0.1:27017/
TENANT_DB_PREFIX=tenant_

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Separate secret for platform-admin tokens, on purpose — a leaked/guessed
# merchant JWT secret should never be usable to forge an admin token.
ADMIN_JWT_SECRET=replace_with_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=12h

# Separate secret again for storefront customer tokens — a customer
# session should never be forgeable from a leaked staff or admin secret,
# and vice versa.
CUSTOMER_JWT_SECRET=replace_with_yet_another_long_random_secret
CUSTOMER_JWT_EXPIRES_IN=30d

PORT=5000
CLIENT_DASHBOARD_ORIGIN=http://localhost:5173
CLIENT_STOREFRONT_ORIGIN=http://localhost:5174

# The bare domain this platform itself is hosted on, e.g. "yourplatform.com".
# When set, a request to "<slug>.yourplatform.com" auto-resolves to that
# tenant (see /api/public/resolve). Leave blank for local dev — path-based
# /:slug routing on the storefront always works regardless of this setting.
PLATFORM_DOMAIN=
